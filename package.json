{
  "name": "goease-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/validate-site.mjs --syntax-only",
    "build": "npm run build:hero && node scripts/validate-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:hero": "esbuild src/hero-birds.js src/bird-study.js src/marine-study.js --bundle --minify --format=esm --outdir=dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  }
}
